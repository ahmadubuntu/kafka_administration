# Example inventory — copy to config/clusters/devkafka.env and adjust.
# Rule: the script only probes ports listed here. Never guess ports in code.
#
#   cp config/clusters/devkafka.example.env config/clusters/devkafka.env

CLUSTER_NAME="devkafka (chr-db-kfk-gen-dev)"
SSH_PORT=22

# Optional floating VIP / LB in front of brokers (leave empty if clients hit brokers directly)
VIP_HOST=""
VIP_CLIENT_PORTS="9094"
LB_HOSTS=""
LB_CLIENT_PORTS="9094"
LB_BACKEND_PORTS="9094"

# Brokers (KRaft combined nodes list the same hosts under CONTROLLER_HOSTS)
BROKER_HOSTS="10.104.120.17"
CONTROLLER_HOSTS="10.104.120.17"
KAFKA_MODE="kraft"

# Verified listeners on this environment
KAFKA_CLIENT_PORT=9092
KAFKA_CLIENT_PORTS="9092"
KAFKA_EXTERNAL_PORT=9094
KAFKA_INTER_BROKER_PORT=9092
KAFKA_CONTROLLER_PORT=9093
KAFKA_ADMIN_PORTS="7071,8779"

# How the checker talks to Kafka (paths on broker OR paths on checker laptop)
KAFKA_BIN="/opt/kafka/bin"
KAFKA_BOOTSTRAP="10.104.120.17:9094"
KAFKA_COMMAND_CONFIG="/opt/kafka/config/admin.properties"
KAFKA_SERVER_PROPERTIES="/var/opt/kafka/config/server.properties"
KAFKA_LOG_DIR="/var/opt/kafka/logs"
KAFKA_SYSTEMD_UNIT="kafka"
KAFKA_JOLOKIA_URL="http://127.0.0.1:8779/jolokia"
KAFKA_PROBE_TIMEOUT_SEC=15
KAFKA_ADMIN_TIMEOUT_SEC=90

# Ports the checker machine is expected to reach; others closed → INFO not FAIL
CHECKER_REACHABLE_PORTS="9094,22"
# Cluster-internal / admin — listen + mesh matter; local miss from laptop is OK
CLUSTER_INTERNAL_PORTS="9092,9093,7071,8779"

# Unexpected-listener allowlists
ALLOW_PORTS_BROKER="9092,9093,9094,7071,8779"
ALLOW_PORTS_CONTROLLER="9093"
ALLOW_PORTS_LB="9094"
ALLOW_PORTS_VIP="9094"
ALLOW_PORTS_AGENTS="10050,9100"

# EXPECT_* config drift (live vs desired)
EXPECT_MIN_INSYNC_REPLICAS="1"
EXPECT_UNCLEAN_LEADER_ELECTION="false"
EXPECT_TLS="0"

# Thresholds
DISK_WARN_PCT=80
DISK_FAIL_PCT=90
LOAD_WARN_RATIO=1.5
LOAD_FAIL_RATIO=3.0
CONN_WARN_PCT=70
CONN_FAIL_PCT=90
CONN_SOFT_CEILING=3200
URP_WARN_COUNT=5
PREF_IMBALANCE_WARN=50
LAG_WARN=10000
LAG_FAIL=100000
HANDLER_BUSY_WARN_PCT=70
HANDLER_BUSY_FAIL_PCT=90
TCP_TIMEOUT_SEC=3
SSH_TIMEOUT_SEC=12
SSH_RETRY_TIMEOUT_SEC=35
SSH_SLOW_WARN_MS=3000
PARALLEL_JOBS=8
SSH_CONTROL_PERSIST_SEC=120
