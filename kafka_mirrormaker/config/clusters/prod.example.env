# Source (production) cluster — copy to prod.env on the MM host (gitignored).
CLUSTER_NAME="prod"
ROLE="source"

KAFKA_BIN="/var/opt/kafka/bin"
KAFKA_BOOTSTRAP="10.0.0.1:9094,10.0.0.2:9094"
# Admin client properties ON THIS MM HOST (not on the brokers)
KAFKA_COMMAND_CONFIG="/var/opt/kafka/config/prod-admin.properties"

# Optional later for --via ssh
BROKER_HOSTS=""
SSH_PORT=7412

LAG_WARN=10000
LAG_FAIL=100000
CHECKPOINT_STALE_SEC=300
