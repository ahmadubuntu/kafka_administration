# Destination (DR) cluster — copy to dr.env on the MM host (gitignored).
CLUSTER_NAME="dr"
ROLE="dest"

KAFKA_BIN="/var/opt/kafka/bin"
KAFKA_BOOTSTRAP="10.0.1.1:9094,10.0.1.2:9094"
KAFKA_COMMAND_CONFIG="/var/opt/kafka/config/dr-admin.properties"

BROKER_HOSTS=""
SSH_PORT=7412

LAG_WARN=10000
LAG_FAIL=100000
CHECKPOINT_STALE_SEC=300
